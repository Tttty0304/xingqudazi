# 本地开发/演示模板：复制为 .env 后按需修改。真实密钥绝不提交到仓库。
APP_ENV=development
POSTGRES_USER=im_user
POSTGRES_PASSWORD=im_password
POSTGRES_DB=xingqudazi_im
JWT_SECRET=local-development-secret-change-before-production
CORS_ALLOWED_ORIGINS=*
SESSION_COOKIE_SECURE=false
AUTH_OMIT_TOKEN_RESPONSE=false
ALLOW_GUEST=true
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
MAX_MESSAGE_LENGTH=1000
MAX_UPLOAD_SIZE_BYTES=5242880
# 生产环境必须固定配置 VAPID 密钥；本地未填时仅生成临时密钥。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
