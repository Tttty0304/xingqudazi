# 生产模板：复制为 .env.production，填入真实值后以 --env-file 启动生产 Compose。
APP_ENV=production
DOMAIN=chat.example.com
POSTGRES_USER=im_user
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=xingqudazi_im
JWT_SECRET=REPLACE_WITH_A_32_PLUS_CHARACTER_RANDOM_SECRET
CORS_ALLOWED_ORIGINS=https://chat.example.com
SESSION_COOKIE_SECURE=true
AUTH_OMIT_TOKEN_RESPONSE=true
ALLOW_GUEST=true
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
MAX_MESSAGE_LENGTH=1000
MAX_UPLOAD_SIZE_BYTES=5242880
VAPID_PUBLIC_KEY=REPLACE_WITH_FIXED_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_FIXED_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@example.com
