# IDE / OS
.DS_Store
.idea/
.vscode/

# 数据库数据卷（Docker Compose named volume 不受影响，此处防止误挂本地目录）
pgdata/

# 数据库备份产物（scripts/db_backup.sh 生成，属本地运行时产物，不入库）
backups/

# 本地图片上传目录（Docker 具名卷，运行时产物不入库）
uploads/

# iWiki plugin files
.iwiki

