HTTP_ADDR=:8080
POSTGRES_DSN=postgres://im_user:im_password@localhost:5432/xingqudazi_im?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=please-change-me-in-production
JWT_EXPIRY=24h
ALLOW_GUEST=true
SHUTDOWN_TIMEOUT=15s
RATE_LIMIT_PER_MINUTE=60
MAX_MESSAGE_LENGTH=1000

# 能力补齐：跨域白名单，逗号分隔；默认 "*" 保持完全放开（demo/评估项目默认行为
# 不变），生产环境应配置为真实域名列表，如 https://chat.example.com
CORS_ALLOWED_ORIGINS=*

# 能力补齐：登录接口暴力破解防护，单 IP 每分钟允许的登录尝试次数上限
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Task16 图片消息
MEDIA_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Task18 内容安全：逗号分隔的敏感词列表，未设置时使用代码内置的演示词表
SENSITIVE_WORDS=

# Task17 Web Push：未设置时进程启动自动生成临时密钥（重启后旧浏览器订阅失效，
# 仅适合本地/demo；生产环境务必固定配置，可用 `webpush.GenerateVAPIDKeys()`
# 一次性生成后写入这里）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 能力补齐：LLM 驱动机器人最小验证（仅 cmd/bot 读取，核心 server 进程不依赖，
# 未设置不影响主服务启动）。LLM_API_KEY 与 DASHSCOPE_API_KEY 二选一即可
# （通义千问/百炼平台习惯用后者命名，本项目兼容两种写法）。
# !!! 真实 API Key 只应写入不入库的本地 server/.env，不要写在这个模板文件里 !!!
LLM_PROVIDER=qwen
LLM_API_KEY=
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 以下四项仅 cmd/bot 使用，均有合理默认值，一般不需要修改：
# BOT_SERVER_BASE_URL=http://localhost:8080
# BOT_USERNAME=ai_zhidai_bot
# BOT_PASSWORD=BotPass1234
# BOT_ROOM_NAME=
# BOT_TARGET_USERNAMES=moonteng,lili
